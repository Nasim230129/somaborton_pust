# ==============================================================================
# PUST Alumni Network (Somaborton PUST) - Environment Configuration Template
# For production deployment on Vercel & local development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-ONLY SECRETS (Required on Vercel & Backend)
# Do NOT prefix these with VITE_ or expose them in client bundles.
# ------------------------------------------------------------------------------

# MongoDB Atlas connection string (Server-Only, Sensitive Secret)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/somaborton_pust?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://db_user:YOUR_STRONG_PASSWORD@cluster0.xxxxx.mongodb.net/somaborton_pust?retryWrites=true&w=majority

# JWT signing secret key (Server-Only, Sensitive Secret)
# Must be a long, cryptographically random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Node runtime environment (Server-Only)
# Options: development | production | test
NODE_ENV=production

# Server port for standalone mode (Optional, default: 5000)
PORT=5000

# Connection timeout for MongoDB Atlas in milliseconds (Optional, default: 5000)
MONGO_TIMEOUT=5000

# Primary production website URL (Server-Only, used for strict CORS verification)
# Example: https://alumni.pust.ac.bd or https://somaborton-pust.vercel.app
APP_URL=https://alumni.pust.ac.bd

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE PUBLIC VARIABLES (Frontend Vite)
# These are baked into the frontend build at build time.
# ------------------------------------------------------------------------------

# Public application base URL (Public)
VITE_APP_URL=https://alumni.pust.ac.bd

# External API base URL (Public, Optional)
# Leave empty or omit when deploying both frontend and backend on Vercel (defaults to relative '/api')
# Set only if backend is hosted on a separate external server (e.g. https://api.pust.ac.bd)
VITE_API_URL=
